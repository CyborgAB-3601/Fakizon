{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "redirects": [
    {
      "source": "/((?!assets/|\\.well-known/).*)",
      "missing": [
        {
          "type": "header",
          "key": "x-shieldforge-origin"
        }
      ],
      "destination": "https://shieldforge-mauve.vercel.app/t/fakizon/$1",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/assets/uploads/(.*)",
      "destination": "/api/index.php"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/\\.well-known/(.*)",
      "destination": "/api/index.php"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "x-shieldforge-origin"
        }
      ],
      "destination": "/api/index.php"
    }
  ]
}